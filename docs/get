#!/bin/sh
set -e
curl -LO https://github.com/hipponix/hippoarch/releases/latest/download/hippoarch.tar.gz
tar xzf hippoarch.tar.gz
rm hippoarch.tar.gz
echo ""
echo "HippoArch downloaded. Follow the steps below to install."
echo ""
echo "  cd hippoarch"
echo ""
echo "  1. Browse the available profiles and pick the one that matches your hardware:"
echo "       ls profiles/"
echo ""
echo "  2. Open your profile and fill in the required fields:"
echo "       DISK        — target drive, e.g. /dev/nvme0n1  (check with: lsblk)"
echo "       HOSTNAME    — machine name"
echo "       USERNAME    — your user account"
echo "       ROOT_PASSWORD / USER_PASSWORD — the script refuses to run if left as 'changeme'"
echo ""
echo "       vim profiles/workstation.conf"
echo ""
echo "  3. Start the installation:"
echo "       bash bootstrap.sh profiles/workstation.conf"
