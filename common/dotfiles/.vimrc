set number
syntax on
filetype on
set cursorline
"set cursorcolumn
set shiftwidth=4
set tabstop=4
set nobackup
set scrolloff=10
"set nowrap
set incsearch
set smartcase
set showcmd
set showmode
set showmatch
set hlsearch
set history=1000
set wildmenu
set wildmode=list:longest
set wildignore=*.docx,*.jpg,*.png,*.gif,*.pdf,*.pyc,*.exe,*.flv,*.img,*.xlsx
